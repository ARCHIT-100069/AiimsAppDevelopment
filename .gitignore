# OS
.DS_Store

# Dependencies
node_modules/

# Build outputs
next-env.d.ts
dist/
build/
.next/
.turbo/
*.tsbuildinfo
# Compiled TS emitted next to source must never be committed (F3 guard)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map

# Environment — secrets never committed (SDR-0006)
.env
.env.*
!.env.example

# Logs & coverage
*.log
coverage/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Python (apps/ai)
__pycache__/
*.pyc
.venv/

# Expo / mobile
.expo/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
