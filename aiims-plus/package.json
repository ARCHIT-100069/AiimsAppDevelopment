{
  "name": "aiims-plus",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter @aiims/db test:isolation",
    "db:migrate": "pnpm --filter @aiims/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.11.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "prettier": "^3.3.0"
  }
}
