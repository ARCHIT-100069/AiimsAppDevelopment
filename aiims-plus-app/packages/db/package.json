{
  "name": "@aiims/db",
  "version": "0.0.0",
  "private": true,
  "description": "The ONLY home of Drizzle and the pg driver (ADR-0011/BDR-0003): schema, reviewed SQL migrations (RLS/roles/partitions — DDR-0011), tenant-context helper (DDR-0002), seed, policy-diff check",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "check:rls": "node dist/check-rls-policies.js",
    "verify:audit": "node dist/verify-audit.js"
  },
  "dependencies": {
    "@aiims/domain-types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "^8.22.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@aiims/typescript-config": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
