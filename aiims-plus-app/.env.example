# ============================================================================
# AIIMS+ environment template (BDR-0011: Zod-validated at boot, fail-fast).
#
# Copy to .env for local development (`cp .env.example .env`). Values below
# match docker-compose.yml. SECRETS ARE NEVER COMMITTED (SDR-0006): .env is
# gitignored; deployed environments inject secrets from AWS Secrets Manager
# via task roles — never from files or images.
# ============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (DDR-0002/0003) ------------------------------------------------
# Runtime connection: MUST be aiims_app (no BYPASSRLS — FORCE RLS applies).
DATABASE_URL_APP=postgres://aiims_app:aiims_app_dev_pw@localhost:5432/aiims
# Migrations/seed only (DDR-0011); local dev uses the compose superuser.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@localhost:5432/aiims
# Role passwords consumed by the migration runner (local-dev defaults).
AIIMS_APP_PASSWORD=aiims_app_dev_pw
AIIMS_MIGRATOR_PASSWORD=aiims_migrator_dev_pw
AIIMS_READONLY_PASSWORD=aiims_readonly_dev_pw

# --- Redis / BullMQ (Blueprint §15) -------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Identity: Keycloak OIDC (ADR-0008, SDR-0001) -----------------------------
OIDC_ISSUER_URL=http://localhost:8080/realms/aiims
OIDC_AUDIENCE=aiims-api

# --- Outbox dispatcher (DDR-0007) ---------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# --- Adapters (ADR-0010: mock by default; "real" is Stage 8 work) --------------
ADAPTER_ABDM=mock
ADAPTER_CONSENT=mock
ADAPTER_PAYMENT=mock
ADAPTER_NOTIFICATION=mock
ADAPTER_AI=mock

# --- PHI field encryption (DDR-0006; decision S2-b KeyProvider seam) ----------
# LOCAL-DEV-ONLY keys (32-byte hex). Production uses AWS KMS at bootstrap;
# LocalKeyProvider refuses to start with NODE_ENV=production.
KEY_PROVIDER=local
AIIMS_FIELD_MASTER_KEY=af836c79b1a100fe1da0e6ba73b32c10911dfcd2cf83d0106ef6d20ff0515bc8
AIIMS_BLIND_INDEX_KEY=35d471d829185923ff21e9f0b2e6ebb6fff170c16689b028dfdedaa41e38a452

# --- Observability (IDR-0013): tracing activates only when an OTLP endpoint is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Object storage (IDR-0016: MinIO locally, S3 in AWS; idle in Stage 0) ------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1

# --- Web BFF (SDR-0001 / FEDR-0007) — server-side only, never shipped to browser
SESSION_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
OIDC_CLIENT_ID=aiims-web
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
API_BASE_URL=http://localhost:3000
